NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optionnel : URL publique du serveur MCP. Par défaut NEXT_PUBLIC_APP_URL + /mcp.
# NEXT_PUBLIC_MCP_RESOURCE_URL=https://example.com/mcp

# Resend (envoi d’emails transactionnels et outil MCP send_email)
RESEND_API_KEY=re_your_resend_api_key
# Adresse d’expédition vérifiée dans Resend, ex. : SkillFlow <noreply@votre-domaine.com>
RESEND_FROM_EMAIL=SkillFlow <noreply@example.com>
SKILLFLOW_ADMIN_EMAIL=owner@example.com
SKILLFLOW_COMMERCE_ENABLED=false
CRON_SECRET=
SASPAY_API_KEY=sk_live_replace-with-live-key
SASPAY_API_URL=https://api.saspay.me/api/v1
SASPAY_CHECKOUT_SESSION_STATUS_PATH=/checkout-sessions/{id}/
SASPAY_WEBHOOK_SECRET=replace-with-live-webhook-signing-secret
# Short-lived Supabase access token for a trusted administrator, used by the recovery CLI.
SKILLFLOW_ADMIN_ACCESS_TOKEN=replace-with-a-short-lived-admin-access-token

# Inbound messaging (keep disabled until the module is fully configured)
MESSAGING_ENABLED=false
DRY_RUN=true

META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=

# WhatsApp webhook intake requires the registered phone-number ID.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Keep false until separately approved; both this and DRY_RUN=false are required for live sends.
WHATSAPP_LIVE_SENDS_ENABLED=false

# Page messaging intake requires a published Meta app subscribed to the
# appropriate messages webhook field; customer access requires Meta review.
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=

INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

MAX_OUTBOUND_PER_CONTACT_PER_DAY=3
MAX_OUTBOUND_PER_HOUR=50

GROWTH_ENABLED=false
GROWTH_PUBLISHING_ENABLED=false
